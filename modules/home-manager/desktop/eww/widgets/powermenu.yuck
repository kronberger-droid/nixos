;; ─────────────────────────────────────────────────────────────────
;; Power menu — eww port of rofi/powermenu/powermenu.sh
;;
;; Type to filter, Enter to run the top match. eww exposes no key
;; events, but a GTK entry receives keystrokes natively, which is what
;; makes the search box possible at all. What is NOT possible is
;; arrow-key navigation: Up/Down belong to the entry's cursor and
;; there is no way to intercept them. So selection is "filter until
;; your target is top, then Enter", not "arrow down twice".
;;
;;   query   = the search text
;;   pending = "none", or the action waiting for a yes/no
;;
;; eww.yuck owns presentation, nu/power.nu owns behaviour. The action
;; key is the seam. Their order has to agree: this file highlights the
;; first row, power.nu's --match picks the first hit, and if the two
;; disagree the highlighted row is not the one Enter runs.
;;
;; Build notes (eww 0.6.0-unstable, gtk-layer-shell compiled in):
;;   - Three string delimiters: "..." '...' `...` — nest them freely.
;;   - ${EWW_CMD} / ${EWW_CONFIG_DIR} work inside widget attributes
;;     only. A defpoll cannot see them, which is why the action list
;;     below is a literal rather than generated by power.nu.
;;   - jq() is real jq (jaq, embedded), so filtering is a one-liner.
;;   - No if-widget: use :visible {cond} or a ternary in an attribute.
;; ─────────────────────────────────────────────────────────────────

;; ── State ────────────────────────────────────────────────────────

(defvar query "")
(defvar pending "none")

;; Presentation only. power.nu decides which of these prompt first.
(defvar actions '[
  {"key": "lock",      "icon": "󰌾", "filler": false},
  {"key": "suspend",   "icon": "󰤄", "filler": false},
  {"key": "logout",    "icon": "󰍃", "filler": false},
  {"key": "hibernate", "icon": "󰒲", "filler": false},
  {"key": "reboot",    "icon": "󰜉", "filler": false},
  {"key": "shutdown",  "icon": "󰐥", "filler": false}
]')

(defpoll host :interval "1h" :initial "" `hostname`)

;; Same awk one-liner the rofi script used. Backticks so the awk body
;; keeps its own quotes.
(defpoll uptime :interval "30s" :initial ""
  `awk '{h=int($1/3600); m=int(($1%3600)/60); s=int($1%60); printf "%dh %dm %ds", h, m, s}' /proc/uptime`)

;; ── The filtered list ────────────────────────────────────────────
;; The filter pads its result back up to six with blank filler rows, so
;; the list occupies identical space no matter what is typed. This is
;; the same trick rofi uses: style-1.rasi sets `listview { lines: 6 }`,
;; which is why the rofi menu never resizes either. Doing it in the
;; data rather than with a CSS min-height means it stays exact if the
;; font or the padding changes.
;;
;; to_entries gives each row an index, which is the only way to know
;; which one is top and therefore which one Enter will run. Watch the
;; two meanings of "key" here: row.key is that index, row.value.key is
;; the action name.
;;
;; A double quote typed into the search box would break this filter.
;; Not worth guarding for six fixed actions, but worth knowing.

(defwidget power-rows []
  (box :class "rows" :orientation "v" :space-evenly false :spacing 5 :valign "start"
    (for row in {jq(actions,
                    '[.[] | select(.key | ascii_downcase | contains("${query}" | ascii_downcase))] as $f
                     | ($f + [range(6 - ($f | length)) | {"key": "", "icon": "", "filler": true}])
                     | to_entries')}
      ;; Highlight only once something is typed. With an empty query
      ;; power.nu deliberately no-ops, so highlighting a row there would
      ;; promise an Enter that does nothing.
      (eventbox :cursor "pointer"
        (button :class {row.value.filler
                        ? "row filler"
                        : (row.key == 0 && query != "" ? "row top" : "row")}
                :onclick {row.value.filler
                          ? "true"
                          : "${EWW_CONFIG_DIR}/scripts/power ${row.value.key}"}
          (box :space-evenly false :spacing 12 :halign "start"
            (label :class "icon" :text {row.value.icon})
            (label :class "name" :text {row.value.key})))))))

;; ── The confirm screen ───────────────────────────────────────────
;; Enter answers yes here too: the entry keeps focus, and its onaccept
;; switches meaning based on `pending`.

(defwidget confirm []
  (box :class "confirm" :orientation "v" :space-evenly false :spacing 14
    (label :class "question" :text "${pending}?")
    (box :spacing 10 :space-evenly true
      (eventbox :cursor "pointer"
        (button :class "answer yes"
                :onclick "${EWW_CONFIG_DIR}/scripts/power --confirmed ${pending}"
          (label :text " yes")))
      (eventbox :cursor "pointer"
        (button :class "answer no"
                :onclick "${EWW_CMD} update pending=none"
          (label :text " no"))))))

;; ── Panel ────────────────────────────────────────────────────────
;; The search box stays mounted on both screens so focus never has to
;; move, which is also what keeps Enter meaningful on the prompt.

(defwidget panel []
  (box :class "panel" :orientation "v" :space-evenly false :spacing 12
    (box :class "header" :space-evenly false :spacing 10
      (label :class "logo" :text "⏻")
      (label :class "host" :text host)
      (input :class "search"
             :hexpand true
             :value query
             :onchange "${EWW_CMD} update query='{}'"
             :onaccept {pending == "none"
                        ? "${EWW_CONFIG_DIR}/scripts/power --match '{}'"
                        : "${EWW_CONFIG_DIR}/scripts/power --confirmed ${pending}"}))
    (label :class "uptime" :halign "start" :text "Uptime: ${uptime}")
    (box :visible {pending == "none"} (power-rows))
    (box :visible {pending != "none"} (confirm))))

;; ── Window ───────────────────────────────────────────────────────
;; "exclusive" this time, deliberately: the entry needs the keyboard.
;; The earlier accidental-lock was focus landing on a *button*, where
;; the tail of the launching keystroke reads as "activate". Focus now
;; lands in a text field instead, and power.nu no-ops on an empty
;; query, so the same stray Enter does nothing.

(defwindow powermenu
  :monitor 0
  :namespace "powermenu"
  :stacking "overlay"
  :focusable "exclusive"
  :geometry (geometry :width "100%" :height "100%")
  (eventbox :class "backdrop"
            :onclick "${EWW_CMD} update pending=none && ${EWW_CMD} close powermenu"
    (box :halign "center" :valign "center"
      (eventbox :onclick "true"
        (panel)))))
