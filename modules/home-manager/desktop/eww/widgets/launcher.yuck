;; ─────────────────────────────────────────────────────────────────
;; Application launcher — replaces `rofi -show drun` (Mod+D).
;;
;; Only the drun mode is ported. The rofi window carries a
;; mode-switcher row (run / ssh / window) along the bottom; it is
;; only ever used to start applications, so that row is gone.
;;
;; `app_query`, not `query`: one daemon serves every window, so
;; defvars share a single global namespace and the powermenu already
;; owns `query`. Worth remembering as more widgets land.
;; ─────────────────────────────────────────────────────────────────

(defvar app_query "")

;; The list changes only when packages do, so a slow poll is plenty.
;; Relative path: eww resolves defpoll/deflisten commands against the
;; config dir, which is how it gets around ${EWW_CONFIG_DIR} not being
;; in scope at top level.
(defpoll apps :interval "1h" :initial "[]" "scripts/apps list")

;; Matching rule, kept identical to `matches` in nu/apps.nu: substring,
;; case-insensitive, against name or comment. If these two drift, the
;; highlighted row stops being the row Enter runs.
(defwidget app-rows []
  (box :class "rows" :orientation "v" :space-evenly false :spacing 5 :valign "start"
    (for row in {jq(apps,
                    '("${app_query}" | ascii_downcase) as $q
                     | [.[] | select((.name | ascii_downcase | contains($q))
                                     or (.comment | ascii_downcase | contains($q)))]
                     | to_entries')}
      (eventbox :cursor "pointer"
        (button :class {row.key == 0 && app_query != "" ? "app top" : "app"}
                :onclick "${EWW_CONFIG_DIR}/scripts/apps launch '${row.value.id}'"
          (box :space-evenly false :spacing 8 :halign "start"
            (label :class "app-name" :truncate true :text {row.value.name})
            ;; rofi renders the Comment in italics beside the name, and
            ;; omits the parens when there is no comment.
            ;; :truncate, and this is what stops the panel resizing as you
            ;; type: without it a long Comment ("Resource monitor that shows
            ;; usage and stats for processor, memory, disks, …") sets the row's
            ;; width request, so the panel grew and shrank with whichever
            ;; entries survived the filter. An ellipsizing label requests
            ;; almost nothing, leaving .rows' min-width in charge.
            (label :class "app-comment"
                   :truncate true
                   :hexpand true
                   :halign "start"
                   :visible {row.value.comment != ""}
                   :text "(${row.value.comment})")))))))

(defwidget launcher-panel []
  (box :class "launcher" :orientation "v" :space-evenly false :spacing 10
       :halign "center" :valign "center"
    (box :class "inputbar" :space-evenly false :spacing 10
      ;; rofi's textbox-prompt-colon, whose str is "::".
      (label :class "prompt" :text "::")
      ;; eww's input has no placeholder attribute, so "search..." is a label
      ;; layered underneath. The input is the overlay's first child so the
      ;; overlay takes its size; a bare GtkLabel has no input window, so
      ;; clicks fall through to the entry on top of it.
      (overlay :hexpand true
        (input :class "search"
               :hexpand true
               :value app_query
               :onchange "${EWW_CMD} update app_query='{}'"
               :onaccept "${EWW_CONFIG_DIR}/scripts/apps launch-match '{}'")
        (label :class "placeholder"
               :halign "start"
               :visible {app_query == ""}
               :text "search...")))
    ;; rofi: listview { lines: 12; fixed-height: true }. Fixed so the window
    ;; does not resize as the list narrows. Measured off a capture: a row is
    ;; 34px (8px padding twice plus a 17px line) and the gap is 5, so twelve
    ;; whole rows need 12 * 34 + 11 * 5 = 463. At 450 the last row was clipped
    ;; mid-line, which reads as a rendering bug rather than as "scroll for
    ;; more".
    (scroll :class "list" :vscroll true :hscroll false :height 465
      (app-rows))))

(defwindow launcher
  :monitor 0
  :namespace "eww-launcher"
  :stacking "overlay"
  ;; Focus lands in the entry, never on a button: that is what makes the
  ;; keystroke that opened the window harmless, and apps.nu no-ops on an
  ;; empty query as a second layer.
  :focusable "exclusive"
  :geometry (geometry :width "100%" :height "100%")
  (eventbox :class "backdrop-clear"
            :onclick "${EWW_CMD} update app_query='' && ${EWW_CMD} close launcher"
    ;; halign/valign on every wrapper: GTK propagates a child's :hexpand up
    ;; through its ancestors, so the entry's hexpand was expanding the
    ;; backdrop itself and the panel filled the screen.
    (box :halign "center" :valign "center"
      (eventbox :onclick "true" :halign "center" :valign "center"
        (launcher-panel)))))
