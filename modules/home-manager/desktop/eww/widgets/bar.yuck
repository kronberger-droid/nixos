;; ─────────────────────────────────────────────────────────────────
;; The bar. Geometry and styling ported from waybar.nix (height 30,
;; layer top, position top, spacing 10) and waybar/style.css.
;;
;; waybar's window is transparent and each module carries its own
;; background, which is why there is no bar-wide fill here either.
;; ─────────────────────────────────────────────────────────────────

;; waybar: clock { interval = 60; format = "{:%e %b %Y %H:%M}" }.
;; %e space-pads the day, same as waybar, so the width does not jump on
;; the 1st of a month.
(defpoll clock :interval "60s" :initial "" `date +'%e %b %Y %H:%M'`)

;; :spacing 0, not 10. The pills carry `margin: 0 5px` from waybar's CSS, so
;; two adjacent ones already sit 10px apart, which is what waybar measures.
;; Adding box spacing on top made every gap 20px.
(defwidget bar-left [mon]
  (box :halign "start" :valign "center" :space-evenly false :spacing 0
    ;; rofi, as waybar's custom/menu did. The eww launcher this briefly
    ;; pointed at is gone: rofi's drun already handles the environment an
    ;; application expects, which the eww one did not (steam would not start).
    (eventbox :cursor "pointer"
      (button :class "menu" :onclick "${EWW_CONFIG_DIR}/scripts/menu launcher"
        (label :text "")))
    (workspaces :monitor mon)
    (scratchpad)))

(defwidget bar-right []
  (box :halign "end" :valign "center" :space-evenly false :spacing 0
    ;; waybar's modules-right order, complete.
    (toggles-cluster)
    (sep)
    (bluetooth)
    (pulseaudio)
    (mpris)
    (sep)
    (network)
    (vpn)
    (sep)
    (cpu)
    (memory)
    (temperature)
    (sep)
    (tray-cluster)
    ;; waybar: on-click = dropkittenCmd tui.calendar
    (eventbox :cursor "pointer"
      (button :class "clock" :onclick "${EWW_CONFIG_DIR}/scripts/tui calendar"
        (label :text clock)))
    ;; waybar's custom/power ran the rofi script, and so does this again.
    (eventbox :cursor "pointer"
      (button :class "power" :onclick "${EWW_CONFIG_DIR}/scripts/menu power"
        (label :text "")))))

;; One instance per output, opened by scripts/bars as monitors come and go.
;; `mon` is the connector name (HDMI-A-1, DP-2), which does double duty: eww
;; resolves :monitor by name, and bar-left hands the same string to the
;; workspaces widget so each bar draws only its own screen's pills. A name
;; rather than an index deliberately, since indices shift on hotplug.
(defwindow bar [mon]
  :monitor mon
  :namespace "eww-bar"
  ;; "fg" == waybar's layer = "top". Below the powermenu's overlay, which
  ;; is what lets the menu cover the bar when it opens.
  :stacking "fg"
  :exclusive true
  :focusable "none"
  :geometry (geometry :width "100%" :height "30px" :anchor "top center")
  ;; A bar-wide hover-lost that clears every cluster's peek state.
  ;;
  ;; The clusters set their own hover flags on enter and clear them on leave,
  ;; but GTK does not reliably deliver leave-notify when the pointer exits fast:
  ;; the drawer is collapsing and resizing under the pointer at the same time,
  ;; and the crossing event can be missed entirely. The flag then stays true and
  ;; the drawer sticks part-open.
  ;;
  ;; Leaving the bar is a much larger target and a much less racy event, so this
  ;; is the backstop. Both flags are cleared in one `eww update`, which takes
  ;; several assignments at once.
  (eventbox :onhoverlost "${EWW_CMD} update tray_hover=false toggles_hover=false"
    (centerbox :class "bar"
      (bar-left :mon mon)
      (box)
      (bar-right))))
