{
  config,
  lib,
  pkgs,
  inputs,
  ...
}: let
  s = config.scheme;
  vaultRel = lib.removePrefix "${config.home.homeDirectory}/" config.vault.path;
  mkNixPak = inputs.nixpak.lib.nixpak {inherit lib pkgs;};

  # Obsidian in a bubblewrap sandbox, on the pattern of signal.nix. Community
  # plugins are unaudited JS with the app's full reach, and BRAT installs them
  # straight from GitHub, so the reach is cut to where vaults live: the notes
  # tree and ~/Projects (robocat and whatever comes next). No ~/.ssh, no SSH
  # agent, no Secret Service; sync is Syncthing's job, not Obsidian's.
  #
  # Plugins that shell out see only the store, not the host's PATH. Nothing
  # in use does: enhancing-export would want pandoc, but has never been set
  # up and pandoc is not installed.
  obsidian = mkNixPak {
    config = {sloth, ...}: {
      imports = with inputs.nixpak.nixpakModules; [gui-base network];

      app.package = pkgs.obsidian;
      flatpak.appId = "md.obsidian.Obsidian";

      # gui-base bundles its own mesa; the host's driver matches the kernel
      # and is already in the store.
      gpu.provider = lib.mkForce "nixos";

      # Binds the host's /etc/localtime. Without it there is none in the
      # sandbox and every timestamp shows in UTC.
      timeZone.enable = true;

      bubblewrap = {
        bind.rw = [
          (sloth.mkdir (sloth.concat' sloth.xdgConfigHome "/obsidian"))
          (sloth.concat' sloth.homeDir "/Documents/notes")
          (sloth.concat' sloth.homeDir "/Projects")
          (sloth.concat' sloth.homeDir "/Downloads")
          # A private /tmp, see signal.nix.
          [(sloth.mkdir (sloth.concat' sloth.appCacheDir "/tmp")) "/tmp"]
        ];
      };
    };
  };
in {
  config.home.packages = [obsidian.config.env];

  options.vault = {
    path = lib.mkOption {
      type = lib.types.str;
      default = "${config.home.homeDirectory}/Documents/notes/general-vault";
      description = "Absolute path to the primary Obsidian vault.";
    };
  };

  config.home.activation.obsidianAccentColor = lib.hm.dag.entryAfter ["writeBoundary"] ''
    appearance="${config.vault.path}/.obsidian/appearance.json"
    if [ -f "$appearance" ]; then
      tmp=$(mktemp)
      ${pkgs.jq}/bin/jq --arg c "#${s.base0F}" '.accentColor = $c' "$appearance" > "$tmp" \
        && $DRY_RUN_CMD mv "$tmp" "$appearance"
    fi
  '';

  config.home.file."${vaultRel}/.obsidian/snippets/base16.css".text = ''
    /* Generated by nix from config.scheme — do not edit.
       Toggle on in Obsidian: Settings → Appearance → CSS snippets → base16. */

    .theme-dark {
      --background-primary:         #${s.base00};
      --background-primary-alt:     #${s.base01};
      --background-secondary:       #${s.base01};
      --background-secondary-alt:   #${s.base02};
      --background-modifier-border: #${s.base02};
      --background-modifier-hover:  #${s.base02};

      --text-normal:   #${s.base05};
      --text-muted:    #${s.base04};
      --text-faint:    #${s.base03};
      --text-accent:   #${s.base0F};
      --text-accent-hover: #${s.base0E};
      --text-on-accent: #${s.base00};
      --text-error:    #${s.base08};
      --text-selection: #${s.base02};

      --interactive-accent:       #${s.base0F};
      --interactive-accent-hover: #${s.base0E};
      --interactive-normal:       #${s.base01};
      --interactive-hover:        #${s.base02};

      --h1-color: #${s.base08};
      --h2-color: #${s.base09};
      --h3-color: #${s.base0A};
      --h4-color: #${s.base0B};
      --h5-color: #${s.base0C};
      --h6-color: #${s.base0D};

      --link-color:           #${s.base0F};
      --link-color-hover:     #${s.base0E};
      --link-unresolved-color: #${s.base08};

      --code-normal:     #${s.base05};
      --code-background: #${s.base01};
      --code-string:     #${s.base0B};
      --code-keyword:    #${s.base0E};
      --code-function:   #${s.base0D};
      --code-comment:    #${s.base03};
      --code-property:   #${s.base0A};
      --code-value:      #${s.base09};
      --code-operator:   #${s.base05};
      --code-tag:        #${s.base08};
      --code-important:  #${s.base09};

      --blockquote-border-color: #${s.base0F};
      --hr-color: #${s.base02};
      --tag-color: #${s.base0C};
      --tag-background: #${s.base01};
      --checkbox-color: #${s.base0B};
      --caret-color: #${s.base05};
    }
  '';
}
